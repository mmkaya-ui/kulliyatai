# ==============================================================================
# Kulliyat AI Configuration (.env.example)
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# --- API Keys (Optional if running offline with fastembed) ---
# OpenAI API key (for text-embedding-3-large and GPT models)
OPENAI_API_KEY=

# Google Gemini API key (for Gemini Flash / Pro models and gemini-embedding-001)
GOOGLE_API_KEY=

# OpenRouter API key (for Claude 4.5 Sonnet / Anthropic models)
OPENROUTER_API_KEY=

# Streamlit App Access Password (leave empty to disable password prompt)
STREAMLIT_PASSWORD=

# --- Pipeline & Storage Settings ---
# Directory containing source PDFs (default: sample_docs)
DATA_DIR=sample_docs

# Directory for persisted FAISS index (default: vector_db)
DB_DIR=vector_db

# Embedding provider: "fastembed" (offline CPU, zero key needed), "openai", or "google"
EMBEDDING_PROVIDER=fastembed

# Embedding model name (defaults to provider recommendation if left empty)
# fastembed: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# openai: text-embedding-3-large
# google: gemini-embedding-001
EMBEDDING_MODEL=

# --- Chunking & Retrieval Parameters ---
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4
CANDIDATE_K=20

# Cross-encoder reranker model (offline ONNX, Apache-2.0 licensed)
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8

# Target response language: "tr" (Turkish), "auto" (match question language), or "en"
ANSWER_LANGUAGE=tr
