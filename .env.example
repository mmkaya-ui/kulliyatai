# Copy to .env and adjust. Everything is optional: the defaults run fully offline.

# --- API keys (only for the LLM answer modes / cloud embeddings) -----------------
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional password prompt for the Streamlit app (empty = no prompt)
STREAMLIT_PASSWORD=

# --- Data ---------------------------------------------------------------------------
DATA_DIR=sample_docs
DB_DIR=vector_db
# Tesseract languages for OCR of image-only pages (needs Tesseract + traineddata files)
OCR_LANGUAGES=tur+eng+deu

# --- Embeddings ---------------------------------------------------------------------
# fastembed (local ONNX, no key) | google | openai. Rebuild the index after changing.
EMBEDDING_PROVIDER=fastembed
# Empty = provider default (see rag/config.py)
EMBEDDING_MODEL=

# --- Retrieval (defaults = settings selected on the dev split, see evals/RESULTS.md) --
# Leave these unset to use the selected defaults; uncomment to override.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# CONTEXTUAL_HEADER=true
# DENSE_WINDOWS=true
# BM25_TOKENIZER=prefix5
# CANDIDATE_K=30
# DENSE_WEIGHT=1.0
# BM25_WEIGHT=1.0
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# Reranker score below which the app answers "not found"; "off" disables the gate.
# ABSTAIN_THRESHOLD=

# --- Answers -------------------------------------------------------------------------
# tr | en | de | auto (= language of the question)
ANSWER_LANGUAGE=tr
# Chat model IDs (defaults in rag/config.py)
# LLM_GEMINI_FAST=gemini-3.8-flash
# LLM_GEMINI_PRO=gemini-3.1-pro-preview
# LLM_OPENAI_FAST=gpt-4o-mini
# LLM_OPENROUTER_CLAUDE=anthropic/claude-sonnet-5.5
